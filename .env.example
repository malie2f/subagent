# ===================================================================
# MCP Hub 配置示例
# 复制为 .env 并填入真实的 API Key
# ===================================================================

# ---- Anthropic (Claude Code) ----
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- OpenAI (Codex) ----
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2

# ---- Moonshot (Kimi) ----
MOONSHOT_API_KEY=sk-xxx
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2-0905-preview

# ---- MiniMax ----
# 同时给 mcp_hub.models.minimax（直调 API）和 mcp_hub.tools.mmx（mmx 多模态 CLI）用
MINIMAX_API_KEY=eyJxxx
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# mmx 专用 key（可选；不填就复用上面的 MINIMAX_API_KEY）
# 如果你有 MiniMax Coding Plan 的 key（sk-cp-...），可以单独配：
# MMX_API_KEY=sk-cp-xxx

# ---- 通用 OpenAI 兼容（Ollama / OpenRouter / vLLM / 国产模型私有部署）----
# 名字随便起，调用时用这个名字
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODEL=

# ---- 队列存储 ----
HUB_QUEUE_PATH=./data/tasks.json
HUB_LOG_LEVEL=INFO

# ---- Model aliases（fallback 链）----
# 留空用默认：deepseek/minimax 优先 OpenCode Go/Zen 套餐（你订阅的）
# 格式：JSON 数组，每个元素 {alias, candidates}
# HUB_MODEL_ALIASES_JSON=[{"alias":"deepseek","candidates":["opencode-go/deepseek-v4-pro","botcf/deepseek-v4-pro"]}]

# ---- Subagent 并发 ----
# 0 = 不限制（推荐，让子 agent 随便开）；其他 = 最大并发数
HUB_MAX_CONCURRENT_SUBAGENTS=0

# ---- Dashboard 模型白名单 ----
# 派活 tab 默认显示所有 model（卡片墙很挤）。配这个 JSON 数组只显示这几个。
# 留空 = 显示全部
# HUB_DASHBOARD_PINNED_MODELS=["opencode-go/deepseek-v4-flash","opencode-go/kimi-k3","opencode-go/qwen3.7-plus"]

# ---- Cluster（多 worker 集群，默认开 5 个 deepseek-v4-flash worker）----
# 把任意 coding agent 任务批量喂给 N 个 worker 并行处理，类似 kimi 集群的能力
HUB_CLUSTER_ENABLED=true
HUB_CLUSTER_SIZE=5                                  # 默认 worker 数
HUB_CLUSTER_RUNTIME=opencode                        # 用哪个 runtime
HUB_CLUSTER_MODEL=opencode-go/deepseek-v4-flash     # 统一 model（OpenCode Go 套餐）
HUB_CLUSTER_TOPIC=cluster.work                      # 消费的 topic
HUB_CLUSTER_WORKDIR=.                               # worker 的工作目录
HUB_CLUSTER_CONCURRENCY_PER_WORKER=1                # 每个 worker 同时跑几个任务
HUB_CLUSTER_TASK_TIMEOUT_SEC=600                    # 单任务超时
HUB_CLUSTER_POLL_INTERVAL_SEC=2.0                   # 没任务时 sleep 多久再 poll

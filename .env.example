# ===================================================================
# MCP Hub 配置示例
# 复制为 .env 后按需填写。发布包不包含任何真实密钥或私人网关。
# CLI 运行时请在 dashboard「连接」页亲手点连接，不要依赖预装登录。
# ===================================================================

# ---- Anthropic (Claude Code) ----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ---- Moonshot (Kimi) ----
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2-0905-preview

# ---- MiniMax（call_model 直连；mmx 也可在 dashboard 连接页填 key）----
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# ---- 可选：OpenAI 兼容自建 / 中转 ----
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODEL=

# ---- hedge 多模态网关（可选；也可只在 dashboard 连接页填写）----
HEDGE_BASE_URL=
HEDGE_API_KEY=
# HEDGE_DOWNLOAD_PROXY=          # 可选 HTTP 代理；不设则直连

# ---- 队列 ----
HUB_QUEUE_PATH=./data/tasks.json
HUB_LOG_LEVEL=INFO

# ---- 必须在 dashboard 连接页点过「连接」才能 spawn（默认 true）----
HUB_REQUIRE_RUNTIME_CONNECTION=true

# ---- Model aliases（可选 JSON）。留空用代码里的通用默认，不含个人号池。----
# HUB_MODEL_ALIASES_JSON=

# ---- Subagent 并发：0 = 不限制 ----
HUB_MAX_CONCURRENT_SUBAGENTS=0

# ---- Cluster（默认关闭，按需开启）----
HUB_CLUSTER_ENABLED=false
HUB_CLUSTER_SIZE=0
HUB_CLUSTER_RUNTIME=opencode
HUB_CLUSTER_MODEL=deepseek/deepseek-v4-flash
HUB_CLUSTER_TOPIC=cluster.work
